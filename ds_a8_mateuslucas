{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMukw0xPktDs303TR+yVzSL"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"27e118a4","outputId":"0f6aa5a4-b7a1-4c3e-b7aa-499eb2a04376"},"source":["import os\n","\n","# Função para limpar a tela do terminal, tornando a saída mais organizada\n","def clear_screen():\n","    os.system('cls' if os.name == 'nt' else 'clear')\n","\n","# Inicializa contadores para as opiniões\n","opiniao_excelente = 0\n","opiniao_ruim = 0\n","\n","# Define o número total de entrevistados\n","NUM_ENTREVISTADOS = 50  # Alterar para 10 para testes rápidos\n","\n","print(\"Bem-vindo(a) à pesquisa de satisfação de clientes!\")\n","print(\"Vamos coletar algumas informações para melhorar nosso atendimento.\")\n","\n","# Loop para entrevistar os clientes\n","for i in range(NUM_ENTREVISTADOS):\n","    clear_screen()\n","    print(f\"\\n--- Entrevistado {i + 1} de {NUM_ENTREVISTADOS} ---\")\n","\n","    # Solicita o nome do entrevistado\n","    nome = input(\"Digite o nome do(a) entrevistado(a): \")\n","\n","    # Solicita a idade do entrevistado e valida a entrada\n","    while True:\n","        try:\n","            idade = int(input(\"Digite a idade do(a) entrevistado(a): \"))\n","            if idade > 0:\n","                break\n","            else:\n","                print(\"Idade inválida. Por favor, digite um número positivo.\")\n","        except ValueError:\n","            print(\"Entrada inválida. Por favor, digite um número inteiro para a idade.\")\n","\n","    # Solicita a opinião sobre o atendimento e valida a entrada\n","    while True:\n","        print(\"\\nQual a sua opinião sobre o atendimento?\")\n","        print(\"1 = EXCELENTE\")\n","        print(\"2 = BOM\")\n","        print(\"3 = RUIM\")\n","        try:\n","            opiniao = int(input(\"Digite sua opção (1, 2 ou 3): \"))\n","            if opiniao in [1, 2, 3]:\n","                break\n","            else:\n","                print(\"Opção inválida. Por favor, digite 1, 2 ou 3.\")\n","        except ValueError:\n","            print(\"Entrada inválida. Por favor, digite um número (1, 2 ou 3).\")\n","\n","    # Utiliza estruturas de decisão para verificar a opinião informada\n","    if opiniao == 1:\n","        opiniao_excelente += 1\n","        print(f\"Obrigado(a) {nome}! Sua opinião 'EXCELENTE' foi registrada.\")\n","    elif opiniao == 3:\n","        opiniao_ruim += 1\n","        print(f\"Obrigado(a) {nome}! Sua opinião 'RUIM' foi registrada.\")\n","    else:\n","        print(f\"Obrigado(a) {nome}! Sua opinião 'BOM' foi registrada.\")\n","\n","    input(\"Pressione Enter para continuar...\") # Pausa para o usuário ler a mensagem\n","\n","clear_screen()\n","print(\"\\n--- Pesquisa Finalizada ---\")\n","print(\"Resumo dos resultados:\")\n","print(f\"Quantidade de respostas 'EXCELENTE': {opiniao_excelente}\")\n","print(f\"Quantidade de respostas 'RUIM': {opiniao_ruim}\")\n","print(\"\\nObrigado(a) por participar da pesquisa!\")\n"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Bem-vindo(a) à pesquisa de satisfação de clientes!\n","Vamos coletar algumas informações para melhorar nosso atendimento.\n","\n","--- Entrevistado 1 de 50 ---\n"]}]}]}